{% macro date(label, name, value, opts = {}) %}
    {% import 'form-obj.phtml' as forms %}
    {% set opts = opts | merge({
           class: opts.class ~ " ",
           readonly: true,
           dataFormat: "yyyy-MM-dd",
       })
    %}

    <div class="form-group row">
        <label class="col-lg-3 control-label" for="fld_{{name}}">{{ label }}</label>
        <div class="col-lg-9">
            <div class="input-group cpDateTimeDateOnly">
                {{ forms.input(name, value, opts) }}
                <span class="input-group-addon add-on">
                    <i class="icon-calendar" data-time-icon="icon-time" data-date-icon="icon-calendar"></i>
                </span>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro time(label, name, value, opts = {}) %}
    {% import 'form-obj.phtml' as forms %}
    {% set opts = opts | merge({
           class: opts.class ~ " ",
           readonly: true,
           dataFormat: "hh:mm",
       })
    %}
    <div class="form-group row">
        <label class="col-lg-3 control-label" for="fld_{{name}}">{{ label }}</label>
        <div class="col-lg-9">
            <div class="input-group cpTimepicker">
                {{ forms.input(name, value, opts) }}
                <span class="input-group-addon add-on">
                    <i class="icon-time"></i>
                </span>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro captcha(label, name, value, opts = {}) %}
    {% import 'form-obj.phtml' as forms %}
    {% import 'lang.phtml' as lang %}
    <div class="form-group row">
        <label class="col-lg-3 control-label" for="fld_{{name}}">{{ label }}</label>
        <div class="col-lg-9">
            {{ forms.input(name, value, opts) }}
        </div>
    </div>

    <div class="form-group row">
        <div class='col-lg-offset-3 col-lg-9'>
            <img id='captcha' src='{{ cpCfg.cp_library_path_alias }}lib_php/securimage/securimage_show.php' alt='Anti-spam Code' />
            <i class="icon-refresh"></i><a href='#' class='reloadCaptcha' captcha_id='captcha'>{{ lang.gd('reload') }}</a>
        </div>
    </div>
{% endmacro %}

