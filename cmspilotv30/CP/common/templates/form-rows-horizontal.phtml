{% macro input(label, name, value, opts = {}) %}
    {% import 'form-obj.phtml' as forms %}
    {% set opts = {
        fldWrapClass: 'col-lg-9',
       } | merge(opts)
    %}
    <div class="form-group row {{name}}_wrapper'">
        <label class="col-lg-3 control-label" for="fld_{{name}}">{{ label }}</label>
        <div class="{{ opts.fldWrapClass }}">
            {{ forms.input(name, value, opts) }}
        </div>
    </div>
{% endmacro %}

{% macro fileUpload(label, name, value, opts = {}) %}
    {% import 'form-obj.phtml' as forms %}
    <div class="form-group row">
        <label class="col-lg-3 control-label" for="fld_{{name}}">{{ label }}</label>
        <div class="col-lg-9">
            <input type="file" name='{{ name }}' id='fld_{{name}}'>
        </div>
    </div>
{% endmacro %}

