	<style name="normal_text_bold" fontName="Arial" fontSize="10" isBold="true"/>
	<style name="big_text1_bold" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="big_text1" fontName="Arial" fontSize="12"/>
	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("./")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="record_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["778,790,793,794,795,796,797,798,799,800,801,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,836,835,837,838,840"]]></defaultValueExpression>
	</parameter>
	<parameter name="actual_hours_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT ROUND(sum(hours)) as total_hours FROM timesheet WHERE task_id = t.project_id)"]]></defaultValueExpression>
	</parameter>
	<parameter name="search_criteria_display" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["all"]]></defaultValueExpression>
	</parameter>
	<parameter name="where_condition_staff" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_MG_LIB" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CONCAT_WS(' ', s.first_name, s.last_name) AS staff_name
      ,IF (o.opportunity_id IS NOT NULL AND o.opportunity_id != '',
           o.title,
           p.title
      ) AS project_opp_title

      ,IF (o.opportunity_id IS NOT NULL AND o.opportunity_id != '',
           o.opportunity_code,
           p.project_code
      ) AS project_opp_code
      ,p.estimated_finish_date
      ,SUM(DISTINCT t.estimated_hours) AS total_est_hours
      ,SUM(DISTINCT ts.hours) AS total_actual_hours
FROM task t
LEFT JOIN project p     ON (p.project_id = t.project_id)
LEFT JOIN opportunity o ON (o.opportunity_id = t.opportunity_id)
JOIN task_staff ts2     ON (ts2.task_id = t.task_id)
JOIN staff s            ON (s.staff_id = ts2.staff_id)
LEFT JOIN timesheet ts  ON (ts.task_id = t.task_id AND ts.staff_id = s.staff_id)
WHERE t.task_id IN ($P!{record_ids})
      $P!{where_condition_staff}
GROUP BY s.staff_id
        ,project_opp_code
ORDER BY staff_name
        ,project_opp_title]]>
	</queryString>
	<field name="staff_name" class="java.lang.String"/>
	<field name="project_opp_title" class="java.lang.String"/>
	<field name="project_opp_code" class="java.lang.String"/>
	<field name="estimated_finish_date" class="java.sql.Date"/>
	<field name="total_est_hours" class="java.lang.Double"/>
	<field name="total_actual_hours" class="java.lang.Double"/>
