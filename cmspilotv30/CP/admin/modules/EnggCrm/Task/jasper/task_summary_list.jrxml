				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{DIR_MG_LIB} + "logo-right.jasper"]]></subreportExpression>
			</subreport>
