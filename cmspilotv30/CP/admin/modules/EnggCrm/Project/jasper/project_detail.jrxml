	<style name="big_text1_bold" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="title_text1" fontName="Arial" fontSize="18" isBold="true"/>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="pageCount" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="pageNo" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String" isForPrompting="false"/>
	<parameter name="delivery_count" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2)]]></defaultValueExpression>
	</parameter>
	<parameter name="contact_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="project_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(174)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_MG_LIB" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT title, description
FROM project
WHERE project_id = $P{project_id}]]>
	</queryString>
	<field name="title" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<variable name="printDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[new Date()]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="1" splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="45" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField" x="0" y="31" width="498" height="14" isRemoveLineWhenBlank="true"/>
				<textElement markup="styled">
					<font fontName="Microsoft Sans Serif"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{description}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-1" x="0" y="0" width="498" height="18"/>
				<box>
					<pen lineWidth="0.0" lineStyle="Solid"/>
					<topPen lineWidth="0.0" lineStyle="Solid"/>
					<leftPen lineWidth="0.0" lineStyle="Solid"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid"/>
					<rightPen lineWidth="0.0" lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Microsoft Sans Serif" size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Project: " + $F{title}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
