					<font fontName="Microsoft Sans Serif" size="15" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<text><![CDATA[Timesheet Summary List]]></text>
			</staticText>
			<staticText>
				<reportElement key="staticText-9" positionType="Float" x="0" y="51" width="55" height="11" isRemoveLineWhenBlank="true"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
