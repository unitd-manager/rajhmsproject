	<style name="big_text1" fontName="Arial" fontSize="12"/>
	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("./")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="record_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["868,869,882,876"]]></defaultValueExpression>
	</parameter>
	<parameter name="actual_hours_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT ROUND(sum(hours)) as total_hours FROM timesheet WHERE task_id = t.project_id)"]]></defaultValueExpression>
	</parameter>
	<parameter name="search_criteria_display" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DIR_MG_LIB" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CONCAT_WS(' ', s.first_name, s.last_name) AS staff_name
      ,IF (o.opportunity_id IS NOT NULL AND o.opportunity_id != '',
           o.title,
           p.title
      ) AS project_opp_title

      ,IF (o.opportunity_id IS NOT NULL AND o.opportunity_id != '',
           o.opportunity_code,
           p.project_code
      ) AS project_opp_code

      ,SUM(ts.hours) AS total_actual_hours
FROM timesheet ts
LEFT JOIN project p     ON (p.project_id = ts.project_id)
LEFT JOIN opportunity o ON (o.opportunity_id = ts.opportunity_id)
JOIN staff s            ON (s.staff_id = ts.staff_id)
WHERE ts.timesheet_id IN ($P!{record_ids})
GROUP BY s.staff_id
        ,project_opp_code
ORDER BY staff_name
        ,project_opp_code]]>
	</queryString>
	<field name="staff_name" class="java.lang.String"/>
	<field name="project_opp_title" class="java.lang.String"/>
	<field name="project_opp_code" class="java.lang.String"/>
	<field name="total_actual_hours" class="java.lang.Double"/>
	<variable name="total_hours_by_staff" class="java.lang.Double" resetType="Group" resetGroup="staff_name" calculation="Sum">
		<variableExpression><![CDATA[$F{total_actual_hours}]]></variableExpression>
	</variable>
