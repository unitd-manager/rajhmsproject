				<textField isStretchWithOverflow="true" pattern="###0.00" isBlankWhenNull="true">
					<reportElement key="textField-30" x="385" y="1" width="34" height="14" isRemoveLineWhenBlank="true" isPrintInFirstWholeBand="true"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Microsoft Sans Serif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
					</textElement>
					<textFieldExpression class="java.lang.Double"><![CDATA[$V{total_hours_by_staff}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement key="staticText-19" x="252" y="1" width="133" height="14" isRemoveLineWhenBlank="true"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Microsoft Sans Serif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
					</textElement>
					<text><![CDATA[Total]]></text>
				</staticText>
			</band>
		</groupFooter>
	</group>
