				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{amount}.intValue() == 0 ? "inclusive" :
($F{item_type}.equals("text") || $F{item_type}.equals("blank")) ? "" :
$P{REPORT_SCRIPTLET}.getFormattedNumberAsString($F{amount}.doubleValue(), $F{currency} + " #,##0")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-4" x="0" y="18" width="385" height="14" isRemoveLineWhenBlank="true"/>
				<textElement>
