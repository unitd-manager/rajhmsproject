	</parameter>
	<parameter name="proj_company_name_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT company_name FROM company c JOIN project p ON (c.company_id = p.company_id) WHERE p.project_id = a.project_id)"]]></defaultValueExpression>
	</parameter>
