		<defaultValueExpression><![CDATA["(SELECT contact_id FROM opportunity o WHERE a.opportunity_id = o.opportunity_id)"]]></defaultValueExpression>
	</parameter>
	<parameter name="proj_contact_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT contact_id FROM project p WHERE p.project_id = a.project_id)"]]></defaultValueExpression>
	</parameter>
