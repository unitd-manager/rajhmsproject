	<style name="normal_text_bold" fontName="Arial" fontSize="10" isBold="true"/>
	<style name="big_text1_bold" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="big_text1" fontName="Arial" fontSize="12"/>
	<style name="used_hours">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean($F{used_hours}.doubleValue() > $V{budgeted_hrs}.doubleValue())]]></conditionExpression>
			<style backcolor="#FF9999"/>
		</conditionalStyle>
	</style>
	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("./")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="website_url" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["iatelier.testpilotweb.com"]]></defaultValueExpression>
	</parameter>
	<parameter name="record_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["821"]]></defaultValueExpression>
	</parameter>
	<parameter name="used_inhouse_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT SUM(total_cost) as total_cost FROM timesheet WHERE project_id = p.project_id)"]]></defaultValueExpression>
	</parameter>
	<parameter name="used_hours_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT ROUND(sum(hours)) as total_hours FROM timesheet WHERE project_id = p.project_id)"]]></defaultValueExpression>
	</parameter>
	<parameter name="sort_order" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["p.project_code DESC"]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_MG_LIB" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
      (IF(p.estimated_finish_date = '0000-00-00', NULL, p.estimated_finish_date)) AS estimated_finish_date
      ,p.*
      ,c.company_name
      ,CONCAT_WS(' ', s.first_name, s.last_name) AS project_manager_name
      ,(p.project_value -
        (SELECT SUM(invoice_amount)
         FROM invoice WHERE project_id = p.project_id)
        ) AS still_to_bill

      ,(SELECT SUM(invoice_amount)
        FROM invoice
        WHERE project_id = p.project_id
       ) AS total_billed

      ,(SELECT SUM(invoice_amount)
        FROM invoice
        WHERE project_id = p.project_id
          AND status = 'Paid'
       ) AS total_paid

      ,ROUND(
           ( (IF (ISNULL( $P!{used_inhouse_sql} ),
                  0,
                  $P!{used_inhouse_sql}
                 )
              )  /

             (p.project_value - IF( ISNULL(p.budget_third_party),
                                    0,
                                    p.budget_third_party
                                )
             )

           ) * 100
      ) AS percentage_used

      ,(IF(ISNULL($P!{used_hours_sql}),0, $P!{used_hours_sql}) ) AS used_hours
FROM project p
LEFT JOIN (company c) ON (p.company_id   = c.company_id  )
LEFT JOIN (staff s)   ON (p.project_manager_id = s.staff_id )

WHERE p.project_id IN ($P!{record_ids})
ORDER BY $P!{sort_order}]]>
	</queryString>
