	<variable name="project_value_sum" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{project_value}]]></variableExpression>
	</variable>
	<variable name="still_to_bill_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{still_to_bill}]]></variableExpression>
	</variable>
	<variable name="used_hrs_sum" class="java.lang.Double" calculation="Sum">
