	</variable>
	<variable name="used_inhouse_sum" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{used_inhouse}]]></variableExpression>
	</variable>
	<variable name="budgeted_hrs" class="java.lang.Float">
		<variableExpression><![CDATA[new Float($F{project_value}.intValue() /100)]]></variableExpression>
	</variable>
	<variable name="budgeted_left" class="java.lang.Float">
		<variableExpression><![CDATA[new Float(
     ($F{project_value} == null ? 0 : $F{project_value}.intValue())
   - ($F{budget_third_party} == null ? 0 : $F{budget_third_party}.intValue())
   - ($F{used_inhouse} == null ? 0 : $F{used_inhouse}.intValue())
)]]></variableExpression>
	</variable>
	<variable name="actual_left" class="java.lang.Float">
		<variableExpression><![CDATA[new Float(
     ($F{project_value} == null ? 0 : $F{project_value}.intValue())
   - ($F{used_inhouse} == null ? 0 : $F{used_inhouse}.intValue())
   - ($F{used_third_party} == null ? 0 : $F{used_third_party}.intValue())
)]]></variableExpression>
	</variable>
