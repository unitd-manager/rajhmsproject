	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("./")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="record_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["874"]]></defaultValueExpression>
	</parameter>
	<parameter name="sort_order" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DIR_MG_LIB" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT t.timesheet_id
      ,ta.title
      ,t.hours
      ,t.entry_date
      ,CONCAT_WS(' ', s.first_name, s.last_name) AS staff_name
      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', o.title, p.title
      ) AS project_opp_title

      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', oc.company_name, pc.company_name
      ) AS project_opp_company

      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', o.opportunity_code, p.project_code
      ) AS project_opp_code

      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', 'Opportunity', 'Project'
      ) AS project_or_opp

      ,s.team as staff_team
      ,CONCAT_WS(' ', s.first_name, s.last_name) AS project_manager_name

FROM timesheet t
LEFT JOIN (task ta)       ON (t.task_id            = ta.task_id      )
LEFT JOIN (opportunity o) ON (o.opportunity_id     = t.opportunity_id)
LEFT JOIN (project p)     ON (p.project_id         = t.project_id    )
LEFT JOIN (company oc)    ON (o.company_id         = oc.company_id   )
LEFT JOIN (company pc)    ON (p.company_id         = pc.company_id   )
LEFT JOIN (staff s)       ON (t.staff_id           = s.staff_id      )

WHERE t.timesheet_id IN ($P!{record_ids})
ORDER BY $P!{sort_order}]]>
	</queryString>
	<field name="timesheet_id" class="java.lang.Integer"/>
	<field name="title" class="java.lang.String"/>
	<field name="hours" class="java.lang.Float"/>
	<field name="entry_date" class="java.sql.Date"/>
	<field name="staff_name" class="java.lang.String"/>
	<field name="project_opp_title" class="java.lang.String"/>
	<field name="project_opp_company" class="java.lang.String"/>
	<field name="project_opp_code" class="java.lang.String"/>
	<field name="project_or_opp" class="java.lang.String"/>
	<field name="staff_team" class="java.lang.String"/>
	<field name="project_manager_name" class="java.lang.String"/>
	<variable name="hours_sum" class="java.lang.Float" calculation="Sum">
		<variableExpression><![CDATA[$F{hours}]]></variableExpression>
	</variable>
