	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("./")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="website_url" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["iatelier.testpilotweb.com"]]></defaultValueExpression>
	</parameter>
	<parameter name="record_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["212,438,475,537,543,558,575,576,600,603,606,607,637"]]></defaultValueExpression>
	</parameter>
	<parameter name="sort_order" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DIR_MG_LIB" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT i.*
      ,p.title            AS project_title
      ,c.company_name
      ,DATEDIFF(Now() ,i.invoice_date) AS age
FROM invoice i
LEFT JOIN (project p) ON (i.project_id   = p.project_id  )
LEFT JOIN (company c) ON (p.company_id   = c.company_id  )
WHERE i.invoice_id IN ($P!{record_ids})
ORDER BY $P!{sort_order}]]>
	</queryString>
