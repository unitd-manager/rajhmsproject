	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("./")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="record_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["821"]]></defaultValueExpression>
	</parameter>
	<parameter name="actual_hours_sql" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(SELECT ROUND(sum(hours)) as total_hours FROM timesheet WHERE task_id = t.project_id)"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT t.task_id
      ,t.title
      ,t.status
      ,t.estimated_hours
      ,t.due_date
      ,t.project_manager_id
      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', o.title, p.title
      ) AS project_opp_title

      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', oc.company_name, pc.company_name
      ) AS project_opp_company

      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', o.opportunity_code, p.project_code
      ) AS project_opp_code

      ,IF (
         o.opportunity_id IS NOT NULL AND o.opportunity_id != '', 'Opportunity', 'Project'
      ) AS project_or_opp
      ,(
        SELECT GROUP_CONCAT(
                  CONCAT_WS(' ', stf.first_name, stf.last_name)
                  ORDER BY CONCAT_WS(' ', stf.first_name, stf.last_name)
                  SEPARATOR ', '
               )
        FROM staff stf
            ,task_staff ts
        WHERE ts.task_id   = t.task_id
          AND stf.staff_id = ts.staff_id
      ) AS staff_names

      ,(
        SELECT GROUP_CONCAT(
                  DISTINCT stf.team
                  SEPARATOR ', '
               )
        FROM staff stf
            ,task_staff ts
        WHERE ts.task_id = t.task_id
          AND stf.staff_id = ts.staff_id
          AND stf.team != ''
      ) AS staff_team
      ,CONCAT_WS(' ', s.first_name, s.last_name) AS project_manager_name
      ,(IF(ISNULL($P!{actual_hours_sql}),0, $P!{actual_hours_sql}) ) AS actual_hours

FROM task t
LEFT JOIN (opportunity o) ON (o.opportunity_id     = t.opportunity_id)
LEFT JOIN (project p)     ON (p.project_id         = t.project_id    )
LEFT JOIN (company oc)    ON (o.company_id         = oc.company_id   )
LEFT JOIN (company pc)    ON (p.company_id         = pc.company_id   )
LEFT JOIN (staff s)       ON (p.project_manager_id = s.staff_id      )

WHERE t.task_id IN ($P!{record_ids})
ORDER BY project_manager_name]]>
	</queryString>
