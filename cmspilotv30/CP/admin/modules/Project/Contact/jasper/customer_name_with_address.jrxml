<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="customer_name_with_address" pageWidth="400" pageHeight="100" orientation="Landscape" columnWidth="400" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<style name="small_text2" fontName="Arial" fontSize="7"/>
	<style name="small_text2_bold" fontName="Arial" fontSize="7" isBold="true"/>
	<style name="small_text1" fontName="Arial" fontSize="8"/>
	<style name="small_text1_bold" fontName="Arial" fontSize="8" isBold="true"/>
	<style name="normal_text" fontName="Arial" fontSize="9"/>
	<style name="normal_text_bold" fontName="Arial" fontSize="9" isBold="true"/>
	<style name="big_text1" fontName="Arial" fontSize="12"/>
	<style name="big_text1_bold" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="title_text1" fontName="Arial" fontSize="18" isBold="true"/>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("")]]></defaultValueExpression>
	</parameter>
	<parameter name="pageCount" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="pageNo" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String" isForPrompting="false"/>
	<parameter name="delivery_count" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(2)]]></defaultValueExpression>
	</parameter>
	<parameter name="contact_id" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT CONCAT(
              c.salutation
             ,IF(c.salutation != '', '. ', '')
             ,CONCAT_WS(' ', c.first_name, c.last_name)
             ,IF(c.position != '', ' - ', '')
             ,c.position
       ) AS contact_name
       ,CONCAT_WS('\n',
                        cy.company_name
                       ,IF(ca.address_flat = '' OR ca.address_flat IS NULL, NULL, ca.address_flat)
                       ,IF(ca.address_street = '' OR ca.address_street IS NULL, NULL, ca.address_street)
                       ,IF(ca.address_town = '' OR ca.address_town IS NULL, NULL, ca.address_town)
                       ,IF(ca.address_state = '' OR ca.address_state IS NULL, NULL, ca.address_state)
                       ,IF(ca.address_country = '' OR ca.address_country IS NULL, NULL, ca.address_country)
        ) AS address
FROM contact c
LEFT JOIN (company cy) ON (c.company_id = cy.company_id )
LEFT JOIN (company_address ca) ON (c.company_address_id = ca.company_address_id)
WHERE c.contact_id = $P!{contact_id}]]>
	</queryString>
	<field name="contact_name" class="java.lang.String"/>
	<field name="address" class="java.lang.String"/>
	<variable name="printDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[new Date()]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="30" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField" isPrintRepeatedValues="false" x="0" y="1" width="395" height="14" isRemoveLineWhenBlank="true"/>
				<textElement textAlignment="Left">
					<font fontName="Microsoft Sans Serif"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{contact_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-1" isPrintRepeatedValues="false" x="0" y="15" width="395" height="15" isRemoveLineWhenBlank="true"/>
				<textElement textAlignment="Left">
					<font fontName="Microsoft Sans Serif"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
