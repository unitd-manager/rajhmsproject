	<field name="cbm_per_pc" class="java.math.BigDecimal"/>
	<field name="dimension_h" class="java.lang.Float"/>
	<field name="dimension_w" class="java.lang.Float"/>
	<field name="dimension_d" class="java.lang.Float"/>
	<field name="serial_no" class="java.lang.String"/>
	<field name="sell_unit_price_actual" class="java.math.BigDecimal"/>
	<variable name="sell_unit_price_actual_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sell_unit_price_actual}]]></variableExpression>
	</variable>
	<variable name="sell_unit_price_actual_sum_add_vat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    $V{sell_unit_price_actual_sum}.floatValue() +
    ($V{sell_unit_price_actual_sum}.floatValue() * ($F{tax_percentage}.floatValue() / 100))
)]]></variableExpression>
	</variable>
	<variable name="vat_amount" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    $V{sell_unit_price_actual_sum}.floatValue() * ($F{tax_percentage}.floatValue() / 100)
)]]></variableExpression>
	</variable>
	<variable name="cbm_per_pc_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cbm_per_pc}]]></variableExpression>
	</variable>
