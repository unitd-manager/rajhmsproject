	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("//PILOTSERVER/pilotserver-d/inetpub/Apache/cmsPilot/v29/master/admin/jasper/")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("../../../../../../../../qingdao/httpdocs/admin/images/")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_MG_LIB" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../../Lib/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       c.company_id
      ,c.company_code
      ,so.so_code
      ,so.status
      ,so.sales_order_date
      ,so.sell_currency
      ,(SELECT code FROM valuelist
        WHERE key_text = 'currency'
          AND value = so.sell_currency
        LIMIT 1) AS currency_symbol
      ,so.notes_customer
      ,so.tax_percentage
      ,so.client_so_no
      ,so.contact_id_customer AS contact_id
      ,so.delivery_terms
      ,so.payment_terms
      ,p.product_code
      ,p.title
      ,p.color
      ,p.cbm_per_pc
      ,p.dimension_h
      ,p.dimension_w
      ,p.dimension_d
      ,i.serial_no
      ,i.sell_unit_price_actual
FROM sales_order_inventory soi
JOIN sales_order so ON so.sales_order_id = soi.sales_order_id
JOIN inventory i ON i.inventory_id = soi.inventory_id
JOIN product p ON p.product_id = i.product_id
JOIN company c ON c.company_id = so.company_id_customer
WHERE so.sales_order_id = $P{record_id}]]>
	</queryString>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_code" class="java.lang.String"/>
	<field name="so_code" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="sales_order_date" class="java.sql.Date"/>
	<field name="sell_currency" class="java.lang.String"/>
	<field name="currency_symbol" class="java.lang.String"/>
