	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       c.company_id
      ,c.company_code
      ,po.po_code
      ,po.purchase_order_date
      ,po.buy_currency
      ,po.notes AS po_notes
      ,po.deposit_note
      ,po.shipment_no
      ,po.required_delivery_date
      ,p.product_id
      ,p.product_code
      ,p.title
      ,p.color
      ,p.dimension_h
      ,p.dimension_w
      ,p.dimension_d
      ,p.cbm_per_pc
      ,po.contact_id_supplier AS contact_id
      ,poi.buy_unit_price
      ,poi.quantity
      ,poi.buy_unit_price * poi.quantity AS buy_price
      ,poi.notes_to_supplier
      ,p.cbm_per_pc * poi.quantity AS total_volume
FROM purchase_order_items poi
JOIN purchase_order po ON po.purchase_order_id = poi.purchase_order_id
JOIN product p ON p.product_id = poi.product_id
JOIN company c ON c.company_id = po.company_id_supplier
WHERE po.purchase_order_id = $P{record_id}]]>
	</queryString>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_code" class="java.lang.String"/>
	<field name="po_code" class="java.lang.String"/>
	<field name="purchase_order_date" class="java.sql.Date"/>
	<field name="buy_currency" class="java.lang.String"/>
	<field name="po_notes" class="java.lang.String"/>
