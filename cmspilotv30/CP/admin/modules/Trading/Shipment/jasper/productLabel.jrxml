<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="contact_label" columnCount="3" printOrder="Horizontal" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="179" columnSpacing="19" leftMargin="19" rightMargin="0" topMargin="0" bottomMargin="0" scriptletClass="net.sf.jasperreports.engine.JRDefaultScriptlet">
	<property name="ireport.scriptlethandling" value="2"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="20"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<style name="small_text2_bold" fontName="Arial" fontSize="8" isBold="true"/>
	<style name="small_text2" fontName="Arial" fontSize="8"/>
	<style name="small_text1_bold" fontName="Arial" fontSize="9" isBold="true"/>
	<style name="small_text1" fontName="Arial" fontSize="9"/>
	<style name="normal_text" fontName="Arial" fontSize="10"/>
	<style name="normal_text_bold" fontName="Arial" fontSize="10" isBold="true"/>
	<style name="big_text1_bold" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="big_text1" fontName="Arial" fontSize="12"/>
	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(3)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("//PILOTSERVER/pilotserver-d/inetpub/Apache/cmsPilot/v29/wattis/web_root/admin/jasper/")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT p.product_code
      ,p.title
      ,p.origin
      ,p.material
      ,p.color
      ,CAST(
           CONCAT_WS(' ',
               CONCAT_WS('', 'H.', p.dimension_h)
              ,CONCAT_WS('', 'W.', p.dimension_w)
              ,CONCAT_WS('', 'D.', p.dimension_d)
           ) AS CHAR
       ) AS size
      ,CONCAT('(', s.shipment_code, ')') AS shipment_code
FROM shipment s
JOIN shipment_items si ON si.shipment_id = s.shipment_id
JOIN inventory i ON i.inventory_id = si.inventory_id
JOIN product p ON  p.product_id = i.product_id
WHERE s.shipment_id = $P!{record_id}]]>
	</queryString>
	<field name="product_code" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="origin" class="java.lang.String"/>
	<field name="material" class="java.lang.String"/>
	<field name="color" class="java.lang.String"/>
	<field name="size" class="java.lang.String"/>
	<field name="shipment_code" class="java.lang.String"/>
	<variable name="total_price" class="java.lang.Float"/>
	<variable name="total_amount" class="java.lang.Double"/>
	<variable name="total_amount_sum" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$V{total_amount}]]></variableExpression>
	</variable>
	<variable name="total_qty" class="java.lang.Integer" calculation="Sum"/>
	<variable name="page_no_now" class="java.lang.Integer" resetType="Page">
		<variableExpression><![CDATA[$V{PAGE_NUMBER}]]></variableExpression>
	</variable>
	<variable name="page_no_report" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{PAGE_NUMBER}]]></variableExpression>
	</variable>
	<group name="dummy_for_summary">
		<groupExpression><![CDATA[]]></groupExpression>
		<groupHeader>
			<band splitType="Stretch"/>
		</groupHeader>
		<groupFooter>
			<band splitType="Stretch"/>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="106" splitType="Prevent">
			<textField isBlankWhenNull="true">
				<reportElement key="textField" x="0" y="15" width="175" height="13"/>
				<textElement verticalAlignment="Top" markup="styled">
					<font fontName="Century Gothic" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{product_code}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-7" positionType="Float" x="0" y="40" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{origin}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-8" positionType="Float" x="0" y="52" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{material}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-9" positionType="Float" x="0" y="64" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{color}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-10" positionType="Float" x="0" y="28" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{title}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-11" positionType="Float" x="0" y="76" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{size}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-11" positionType="Float" x="0" y="88" width="175" height="12" isRemoveLineWhenBlank="true"/>
