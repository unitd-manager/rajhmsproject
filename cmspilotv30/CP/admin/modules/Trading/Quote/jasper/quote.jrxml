	<parameter name="DIR_MG_LIB" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../../Lib/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       c.company_id
      ,c.company_code
      ,c.company_name
      ,c.address_flat
      ,c.address_street
      ,c.address_town
      ,c.address_state
      ,c.address_po_code
      ,c.address_country
      ,q.quote_code
      ,q.quote_date
      ,q.sell_currency
      ,(SELECT code FROM valuelist
        WHERE key_text = 'currency'
          AND value = q.sell_currency
        LIMIT 1) AS currency_symbol
      ,q.notes_customer
      ,q.tax_percentage
      ,q.contact_id_customer AS contact_id
      ,q.payment_terms_customer AS payment_terms
      ,q.delivery_terms
      ,e.customer_rfq_code
      ,p.product_code
      ,p.title
      ,p.dimension_h
      ,p.dimension_w
      ,p.dimension_d
      ,p.color
      ,qi.sell_unit_price
      ,qi.quantity
      ,qi.sell_unit_price * qi.quantity AS sell_price

FROM quote_items qi
JOIN quote q ON q.quote_id = qi.quote_id
JOIN product p ON p.product_id = qi.product_id
JOIN enquiry e ON e.enquiry_id = q.enquiry_id
JOIN company c ON c.company_id = e.company_id_customer
WHERE q.quote_id = $P{record_id}]]>
	</queryString>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_code" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="address_flat" class="java.lang.String"/>
	<field name="address_street" class="java.lang.String"/>
	<field name="address_town" class="java.lang.String"/>
	<field name="address_state" class="java.lang.String"/>
	<field name="address_po_code" class="java.lang.String"/>
	<field name="address_country" class="java.lang.String"/>
	<field name="quote_code" class="java.lang.String"/>
	<field name="quote_date" class="java.sql.Date"/>
	<field name="sell_currency" class="java.lang.String"/>
	<field name="currency_symbol" class="java.lang.String"/>
	<field name="notes_customer" class="java.lang.String"/>
	<field name="tax_percentage" class="java.math.BigDecimal"/>
	<field name="contact_id" class="java.lang.Integer"/>
	<field name="payment_terms" class="java.lang.String"/>
	<field name="delivery_terms" class="java.lang.String"/>
	<field name="customer_rfq_code" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="dimension_h" class="java.lang.Float"/>
	<field name="dimension_w" class="java.lang.Float"/>
	<field name="dimension_d" class="java.lang.Float"/>
	<field name="color" class="java.lang.String"/>
	<field name="sell_unit_price" class="java.math.BigDecimal"/>
	<field name="quantity" class="java.lang.Integer"/>
	<field name="sell_price" class="java.math.BigDecimal"/>
	<variable name="sell_price_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sell_price}]]></variableExpression>
	</variable>
	<variable name="sell_price_sum_add_vat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    $V{sell_price_sum}.floatValue() +
    ($V{sell_price_sum}.floatValue() * ($F{tax_percentage}.floatValue() / 100))
)]]></variableExpression>
	</variable>
	<variable name="vat_amount" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    $V{sell_price_sum}.floatValue() * ($F{tax_percentage}.floatValue() / 100)
)]]></variableExpression>
	</variable>
	<variable name="quantity_sum" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{quantity}]]></variableExpression>
	</variable>
