				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_town}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-10" positionType="Float" x="0" y="28" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{company_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-11" positionType="Float" x="0" y="76" width="175" height="12" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_country}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-12" positionType="Float" x="0" y="88" width="175" height="12" isRemoveLineWhenBlank="true"/>
