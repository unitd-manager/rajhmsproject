<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report_header_address" pageWidth="350" pageHeight="300" orientation="Landscape" columnWidth="350" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="DIR_MG_LIB" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../../../../../../../../qingdao/httpdocs/admin/images/"]]></defaultValueExpression>
	</parameter>
	<parameter name="company_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       c.company_code
      ,c.company_name
      ,c.address_flat
      ,c.address_street
      ,c.address_town
      ,c.address_state
      ,c.address_po_code
      ,c.address_country
FROM company c
WHERE c.company_id = $P{company_id}]]>
	</queryString>
	<field name="company_code" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="address_flat" class="java.lang.String"/>
	<field name="address_street" class="java.lang.String"/>
	<field name="address_town" class="java.lang.String"/>
	<field name="address_state" class="java.lang.String"/>
	<field name="address_po_code" class="java.lang.String"/>
	<field name="address_country" class="java.lang.String"/>
	<variable name="printDate" class="java.util.Date" resetType="None">
		<variableExpression><![CDATA[new Date()]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="1" splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="86" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="42" width="272" height="14" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_town}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="70" width="272" height="14" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_country}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="14" width="272" height="14" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_flat}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="0" width="272" height="14"/>
				<textElement>
					<font fontName="Century Gothic" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{company_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="56" width="272" height="14" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_state}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="28" width="272" height="14" isRemoveLineWhenBlank="true"/>
				<textElement>
					<font fontName="Century Gothic" isBold="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{address_street}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Prevent"/>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
