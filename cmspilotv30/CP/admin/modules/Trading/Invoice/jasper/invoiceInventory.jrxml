	<subDataset name="dataset1"/>
	<parameter name="record_id" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_SUBREPORT" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("//PILOTSERVER/pilotserver-d/inetpub/Apache/cmsPilot/v29/master/admin/jasper/")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_IMAGES" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("../../../../../../../../qingdao/httpdocs/admin/images/")]]></defaultValueExpression>
	</parameter>
	<parameter name="DIR_MG_LIB" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["../../Lib/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       c.company_id
      ,c.company_code
      ,i.invoice_type
      ,i.invoice_code
      ,i.invoice_date
      ,i.notes
      ,i.other_cost_lbl
      ,i.other_cost
      ,i.contact_id_customer AS contact_id
      ,i.invoice_amount
      ,i.delivery_amount
      ,so.so_code
      ,so.sell_currency
      ,so.tax_percentage
      ,so.client_so_no
      ,so.delivery_terms
      ,so.payment_terms
      ,(SELECT code FROM valuelist
        WHERE key_text = 'currency'
          AND value = so.sell_currency
        LIMIT 1) AS currency_symbol
      ,p.product_code
      ,p.title
      ,p.cbm_per_pc
      ,p.color

      ,(SELECT COUNT(*)
        FROM invoice_inventory ii2
        WHERE ii2.product_id = ii.product_id
          AND ii2.invoice_id = ii.invoice_id
        ) AS quantity

      ,(SELECT i.sell_unit_price_actual
        FROM inventory i
        WHERE i.inventory_id = ii.inventory_id
        LIMIT 1
        ) AS sell_unit_price_actual

FROM invoice i
LEFT JOIN invoice_inventory ii ON ii.invoice_id = i.invoice_id
JOIN sales_order so ON so.sales_order_id = i.sales_order_id
LEFT JOIN inventory ivt ON ivt.inventory_id = ii.inventory_id
LEFT JOIN product p ON p.product_id = ivt.product_id
JOIN company c ON c.company_id = so.company_id_customer
WHERE i.invoice_id = $P{record_id}
ORDER BY p.web_code]]>
	</queryString>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_code" class="java.lang.String"/>
	<field name="invoice_type" class="java.lang.String"/>
	<field name="invoice_code" class="java.lang.String"/>
	<field name="invoice_date" class="java.sql.Date"/>
	<field name="notes" class="java.lang.String"/>
	<field name="other_cost_lbl" class="java.lang.String"/>
	<field name="other_cost" class="java.math.BigDecimal"/>
	<field name="contact_id" class="java.lang.Integer"/>
	<field name="invoice_amount" class="java.math.BigDecimal"/>
	<field name="delivery_amount" class="java.math.BigDecimal"/>
	<field name="so_code" class="java.lang.String"/>
	<field name="sell_currency" class="java.lang.String"/>
	<field name="tax_percentage" class="java.math.BigDecimal"/>
	<field name="client_so_no" class="java.lang.String"/>
	<field name="delivery_terms" class="java.lang.String"/>
	<field name="payment_terms" class="java.lang.String"/>
	<field name="currency_symbol" class="java.lang.String"/>
	<field name="product_code" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="cbm_per_pc" class="java.math.BigDecimal"/>
	<field name="color" class="java.lang.String"/>
	<field name="quantity" class="java.lang.Long"/>
	<field name="sell_unit_price_actual" class="java.math.BigDecimal"/>
	<variable name="cbm_per_pc_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cbm_per_pc}]]></variableExpression>
	</variable>
	<variable name="sell_price_actual" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    $F{sell_unit_price_actual}.floatValue() * $F{quantity}.intValue()
)]]></variableExpression>
	</variable>
	<variable name="quantity_sum" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{quantity}]]></variableExpression>
	</variable>
	<variable name="sell_price_actual_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{sell_price_actual}]]></variableExpression>
	</variable>
	<variable name="vat_amount" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    (
        ($F{invoice_amount} == null ? 0 : $F{invoice_amount}.floatValue()) +
        ($F{delivery_amount} == null ? 0 : $F{delivery_amount}.floatValue()) +
        ($F{other_cost} == null ? 0 : $F{other_cost}.floatValue())
    )
    * ($F{tax_percentage}.floatValue() / 100)
)]]></variableExpression>
	</variable>
	<variable name="invoice_add_vat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal(
    $F{invoice_amount}.floatValue() +
    ($F{delivery_amount} == null ? 0 : $F{delivery_amount}.floatValue()) +
    ($F{other_cost} == null  ? 0 : $F{other_cost}.floatValue()) +
    ($V{vat_amount} == null ? 0 : $V{vat_amount}.floatValue())
)]]></variableExpression>
	</variable>
