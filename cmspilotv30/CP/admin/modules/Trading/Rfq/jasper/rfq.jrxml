	<field name="buy_unit_price" class="java.math.BigDecimal"/>
	<field name="quantity" class="java.lang.Integer"/>
	<field name="buy_price" class="java.math.BigDecimal"/>
	<variable name="sell_price_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{buy_price}]]></variableExpression>
	</variable>
