		<defaultValueExpression><![CDATA["../../Lib/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
       c.company_id
      ,c.company_code
      ,c.company_name
      ,c.address_flat
      ,c.address_street
      ,c.address_town
      ,c.address_state
      ,c.address_po_code
      ,c.address_country
      ,qr.quote_request_code
      ,qr.quote_request_date
      ,qr.buy_currency
      ,qr.notes_to_supplier
      ,qr.contact_id_supplier AS contact_id
      ,p.product_code
      ,p.title
      ,qri.buy_unit_price
      ,qri.quantity
      ,qri.buy_unit_price * qri.quantity AS buy_price
FROM quote_request_items qri
JOIN quote_request qr ON qr.quote_request_id = qri.quote_request_id
JOIN product p ON p.product_id = qri.product_id
JOIN company c ON c.company_id = qr.company_id_supplier
WHERE qr.quote_request_id = $P{record_id}]]>
	</queryString>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_code" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="address_flat" class="java.lang.String"/>
